{
  "name": "regift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Share a post in, get the video out — a Croft PWA that receives a share from a social platform, extracts the media on-device, and hands it to the next app.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run",
    "build": "node build.mjs",
    "e2e": "playwright test",
    "serve": "node tools/serve.mjs dist 4173",
    "test": "npm run lint && npm run typecheck && npm run unit && npm run build && npm run e2e"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.0"
  }
}
